---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="PROFILE | KANNAGIMARO">
	<main class="profile-page">
		<div class="profile-inner">

			<header class="page-header">
				<h1>PROFILE</h1>
			</header>

			<section class="profile-hero">
				<div class="profile-image">
					<img
						src="/images/kannagimaro-main.jpg"
						alt="カンナギマロ"
					/>
				</div>

				<div class="profile-content">
					<p class="profile-label">
						ARTIST / LYRICIST
					</p>

					<h2>カンナギマロ</h2>

					<p class="profile-name">
						KANNAGIMARO
					</p>

					<p class="profile-description">
						音楽活動や作詞を中心に活動するアーティスト。
						<br />
						2024年よりカンナギマロ名義で活動している。
					</p>

					<div class="profile-links">

						<a
							href="https://x.com/maro_kannagi"
							target="_blank"
							rel="noopener noreferrer"
							aria-label="X"
							title="X"
						>
							<img
								src="/images/icons/x.svg"
								alt=""
							/>
						</a>

						<a
							href="https://www.instagram.com/kanon_fukuda/"
							target="_blank"
							rel="noopener noreferrer"
							aria-label="Instagram"
							title="Instagram"
						>
							<img
								src="/images/icons/instagram.svg"
								alt=""
							/>
						</a>

						<a
							href="https://youtube.com/channel/UCfXTw7zHNmotmKLPSwuWDUw"
							target="_blank"
							rel="noopener noreferrer"
							aria-label="YouTube"
							title="YouTube"
						>
							<img
								src="/images/icons/youtube.svg"
								alt=""
							/>
						</a>

						<a
							href="https://www.tiktok.com/@marokannagi"
							target="_blank"
							rel="noopener noreferrer"
							aria-label="TikTok"
							title="TikTok"
						>
							<img
								src="/images/icons/tiktok.svg"
								alt=""
							/>
						</a>

					</div>
				</div>
			</section>

			<section class="biography">

				<div class="section-heading">
					<p>HISTORY</p>
					<h2>BIOGRAPHY</h2>
				</div>

				<div class="bio-list">

					<div class="bio-item">
						<div class="bio-year">
							2004
						</div>

						<div class="bio-text">
							<p>
								「ハロプロ エッグ オーディション2004」に合格。
								ハロプロエッグの一員として活動を開始。
							</p>
						</div>
					</div>

					<div class="bio-item">
						<div class="bio-year">
							2010
						</div>

						<div class="bio-text">
							<p>
								スマイレージとして「夢見る 15歳」でメジャーデビュー。
								2014年、グループ名をアンジュルムへ改名。
							</p>
						</div>
					</div>

					<div class="bio-item">
						<div class="bio-year">
							2015
						</div>

						<div class="bio-text">
							<p>
								アンジュルムおよびハロー！プロジェクトを卒業。
							</p>
						</div>
					</div>

					<div class="bio-item">
						<div class="bio-year">
							2020
						</div>

						<div class="bio-text">
							<p>
								「巫まろ」名義でZOCに加入。
							</p>
						</div>
					</div>

					<div class="bio-item">
						<div class="bio-year">
							2024
						</div>

						<div class="bio-text">
							<p>
								ZOCを脱退。
								「カンナギマロ」名義で活動を開始。
							</p>
						</div>
					</div>

					<div class="bio-item">
						<div class="bio-year">
							2026
						</div>

						<div class="bio-text">
							<p>
								プロデュースを手がけるアイドルグループ
								「ツキナミ」がデビュー。
							</p>
						</div>
					</div>

				</div>
			</section>

		</div>
	</main>
</BaseLayout>

<style>
	.profile-page {
		min-height: 100vh;

		padding:
			32px
			8%
			72px;

		background:
			radial-gradient(
				circle at 90% 10%,
				rgba(205, 232, 246, 0.34),
				transparent 28%
			),
			linear-gradient(
				180deg,
				#ffffff 0%,
				#fbfdff 100%
			);
	}

	.profile-inner {
		max-width: 1100px;
		margin: 0 auto;
	}

	/* =========================
	   PAGE HEADER
	========================= */

	.page-header {
		margin-bottom: 30px;
	}

	.page-header h1 {
		margin: 0;

		color: #79aeca;

		font-size: clamp(40px, 5vw, 60px);

		font-weight: 300;

		line-height: 1;

		letter-spacing: 0.1em;
	}

	/* =========================
	   PROFILE HERO
	========================= */

	.profile-hero {
		display: grid;

		grid-template-columns:
			minmax(0, 0.9fr)
			minmax(320px, 1.1fr);

		gap: 7%;

		align-items: center;

		margin-bottom: 72px;
	}

	/* IMAGE */

	.profile-image {
		position: relative;
	}

	.profile-image::before {
		content: "";

		position: absolute;

		left: -14px;
		bottom: -14px;

		width: 90%;
		height: 92%;

		border: 1px solid #c8e5f1;

		border-radius: 24px;

		z-index: 0;
	}

	.profile-image img {
		position: relative;

		z-index: 1;

		display: block;

		width: 100%;

		aspect-ratio: 4 / 5;

		object-fit: cover;
		object-position: center;

		border-radius: 24px;
	}

	/* =========================
	   CONTENT
	========================= */

	.profile-content {
		position: relative;
	}

	.profile-label {
		margin: 0 0 12px;

		color: #91bfd3;

		font-size: 9px;

		letter-spacing: 0.28em;
	}

	.profile-content h2 {
		margin: 0;

		color: #72aeca;

		font-size: clamp(32px, 4vw, 52px);

		font-weight: 300;

		line-height: 1.2;

		letter-spacing: 0.08em;
	}

	.profile-name {
		margin: 12px 0 0;

		color: #a69ccc;

		font-size: 13px;

		letter-spacing: 0.2em;
	}

	.profile-description {
		margin: 24px 0 0;

		color: #708995;

		font-size: 13px;

		line-height: 2;
	}

	/* =========================
	   SNS
	========================= */

	.profile-links {
		display: flex;

		align-items: center;

		gap: 20px;

		margin-top: 22px;
	}

	.profile-links a {
		display: grid;

		place-items: center;

		width: 30px;
		height: 30px;

		opacity: 0.75;

		text-decoration: none;

		transition:
			opacity 0.2s ease,
			transform 0.2s ease;
	}

	.profile-links img {
		display: block;

		width: 19px;
		height: 19px;

		object-fit: contain;

		filter:
			invert(66%)
			sepia(19%)
			saturate(880%)
			hue-rotate(158deg)
			brightness(93%)
			contrast(87%);
	}

	.profile-links a:hover {
		opacity: 1;

		transform: translateY(-2px);
	}

	/* =========================
	   BIOGRAPHY
	========================= */

	.biography {
		margin-bottom: 40px;
	}

	.section-heading {
		margin-bottom: 28px;
	}

	.section-heading p {
		margin: 0 0 6px;

		color: #a7cfe1;

		font-size: 9px;

		letter-spacing: 0.3em;
	}

	.section-heading h2 {
		margin: 0;

		color: #79aeca;

		font-size: 28px;

		font-weight: 300;

		line-height: 1;

		letter-spacing: 0.12em;
	}

	/* =========================
	   BIO LIST
	========================= */

	.bio-list {
		border-top: 1px solid #dcecf4;
	}

	.bio-item {
		display: grid;

		grid-template-columns:
			130px
			1fr;

		gap: 32px;

		padding: 22px 0;

		border-bottom: 1px solid #dcecf4;
	}

	.bio-year {
		color: #a69ccc;

		font-size: 13px;

		letter-spacing: 0.15em;
	}

	.bio-text p {
		margin: 0;

		color: #6f8793;

		font-size: 12px;

		line-height: 1.8;
	}

	/* =========================
	   TABLET
	========================= */

	@media (max-width: 900px) {
		.profile-hero {
			grid-template-columns: 1fr;

			gap: 30px;
		}
	}

	/* =========================
	   SMARTPHONE
	========================= */

	@media (max-width: 600px) {
		.profile-page {
			padding:
				20px
				22px
				56px;
		}

		/* HEADER */

		.page-header {
			margin-bottom: 20px;
		}

		.page-header h1 {
			font-size: 32px;
		}

		/* PROFILE */

		.profile-hero {
			gap: 18px;

			margin-bottom: 52px;
		}

		.profile-image::before {
			left: -9px;
			bottom: -9px;

			height: 88%;

			border-radius: 20px;
		}

		.profile-image img {
			/*
				スマホではさらに縦を縮めて、
				最初の1画面に名前まで見せる
			*/
			aspect-ratio: 1.18 / 1;

			object-fit: cover;
			object-position: center 40%;

			border-radius: 20px;
		}

		/* CONTENT */

		.profile-label {
			margin-bottom: 7px;

			font-size: 7px;
		}

		.profile-content h2 {
			font-size: 25px;

			line-height: 1.2;

			letter-spacing: 0.08em;
		}

		.profile-name {
			margin-top: 6px;

			font-size: 10px;

			letter-spacing: 0.18em;
		}

		.profile-description {
			margin-top: 16px;

			font-size: 11px;

			line-height: 1.85;
		}

		.profile-description br {
			display: none;
		}

		/* SNS */

		.profile-links {
			gap: 22px;

			margin-top: 16px;
		}

		.profile-links a {
			width: 32px;
			height: 32px;
		}

		.profile-links img {
			width: 20px;
			height: 20px;
		}

		/* BIOGRAPHY */

		.biography {
			margin-bottom: 26px;
		}

		.section-heading {
			margin-bottom: 22px;
		}

		.section-heading h2 {
			font-size: 23px;
		}

		.bio-item {
			grid-template-columns: 1fr;

			gap: 6px;

			padding: 17px 0;
		}

		.bio-year {
			font-size: 11px;
		}

		.bio-text p {
			font-size: 10px;

			line-height: 1.75;
		}
	}
</style>