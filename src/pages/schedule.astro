---
import BaseLayout from "../layouts/BaseLayout.astro";
import { events } from "../data/events";

type ScheduleType =
	| "EVENT"
	| "LIVE"
	| "TICKET";

type ScheduleItem = {
	id: string;

	date: string;
	type: ScheduleType;

	title: string;

	venue?: string;

	open?: string;
	start?: string;

	ticketTime?: string;

	url?: string;

	isTicket: boolean;
};

/* =========================
   TODAY / JST
========================= */

const getTodayJST = () => {
	const parts = new Intl.DateTimeFormat(
		"en-US",
		{
			timeZone: "Asia/Tokyo",
			year: "numeric",
			month: "2-digit",
			day: "2-digit",
		}
	).formatToParts(new Date());

	const year =
		parts.find(
			(part) =>
				part.type === "year"
		)?.value;

	const month =
		parts.find(
			(part) =>
				part.type === "month"
		)?.value;

	const day =
		parts.find(
			(part) =>
				part.type === "day"
		)?.value;

	return `${year}-${month}-${day}`;
};

const today = getTodayJST();

/* =========================
   EVENTS
   ↓
   DISPLAY SCHEDULE
========================= */

const scheduleItems: ScheduleItem[] =
	events
		.flatMap(
			(event, index): ScheduleItem[] => {

				const items: ScheduleItem[] = [
					{
						id: `event-${index}`,

						date: event.date,

						type: event.type,

						title: event.title,

						venue: event.venue,

						open: event.open,

						start: event.start,

						url: event.url,

						isTicket: false,
					},
				];

				if (event.ticketDate) {
					items.push({
						id: `ticket-${index}`,

						date:
							event.ticketDate,

						type: "TICKET",

						title:
							event.title,

						ticketTime:
							event.ticketTime,

						url:
							event.ticketUrl ||
							event.url,

						isTicket: true,
					});
				}

				return items;
			}
		)
		.sort(
			(a, b) =>
				a.date.localeCompare(
					b.date
				)
		);

/* =========================
   UPCOMING / PAST
========================= */

const upcomingItems =
	scheduleItems.filter(
		(item) =>
			item.date >= today
	);

const pastItems =
	scheduleItems
		.filter(
			(item) =>
				item.date < today
		)
		.reverse();

/* =========================
   DATE FORMAT
========================= */

const formatDate = (
	dateString: string
) => {
	const [
		year,
		month,
		day,
	] = dateString
		.split("-")
		.map(Number);

	const weekdays = [
		"SUN",
		"MON",
		"TUE",
		"WED",
		"THU",
		"FRI",
		"SAT",
	];

	const weekdayIndex =
		new Date(
			Date.UTC(
				year,
				month - 1,
				day
			)
		).getUTCDay();

	return {
		date:
			`${String(month).padStart(2, "0")}.` +
			`${String(day).padStart(2, "0")}`,

		weekday:
			weekdays[
				weekdayIndex
			],
	};
};

/* =========================
   TYPE LABEL
========================= */

const getTypeLabel = (
	type: ScheduleType
) => {
	switch (type) {
		case "LIVE":
			return "ライブ";

		case "TICKET":
			return "チケ発";

		default:
			return "イベント";
	}
};

/* =========================
   GOOGLE MAPS
========================= */

const createGoogleMapsUrl = (
	venue: string
) => {
	return (
		"https://www.google.com/maps/search/?api=1&query=" +
		encodeURIComponent(
			venue
		)
	);
};

/* =========================
   GOOGLE CALENDAR
========================= */

const formatGoogleDate = (
	date: Date
) => {
	return date
		.toISOString()
		.replace(
			/[-:]/g,
			""
		)
		.replace(
			/\.\d{3}/,
			""
		);
};

const createGoogleCalendarUrl = (
	item: ScheduleItem
) => {

	/* =====================
	   TICKET
	===================== */

	if (item.isTicket) {

		if (!item.ticketTime) {
			return null;
		}

		const startDate =
			new Date(
				`${item.date}T${item.ticketTime}:00+09:00`
			);

		const endDate =
			new Date(
				startDate.getTime() +
					60 *
						60 *
						1000
			);

		const description = [
			`チケット発売 ${item.ticketTime}`,
			"",
			"※カレンダー上の終了時刻は便宜上、発売開始から1時間後に設定しています。",

			item.url &&
			item.url !== "#"
				? `\n詳細：\n${item.url}`
				: null,
		]
			.filter(Boolean)
			.join("\n");

		const params =
			new URLSearchParams({
				action:
					"TEMPLATE",

				text:
					`【チケ発】${item.title}`,

				dates:
					`${formatGoogleDate(startDate)}` +
					`/${formatGoogleDate(endDate)}`,

				details:
					description,
			});

		return (
			"https://calendar.google.com/calendar/render?" +
			params.toString()
		);
	}

	/* =====================
	   EVENT / LIVE
	===================== */

	const calendarStartTime =
		item.open ||
		item.start;

	if (!calendarStartTime) {
		return null;
	}

	const startDate =
		new Date(
			`${item.date}T${calendarStartTime}:00+09:00`
		);

	const endDate =
		new Date(
			startDate.getTime() +
				3 *
					60 *
					60 *
					1000
		);

	const timeInfo = [
		item.open
			? `OPEN ${item.open}`
			: null,

		item.start
			? `START ${item.start}`
			: null,
	]
		.filter(Boolean)
		.join(" / ");

	const endTimeNote =
		item.open
			? "※終了時刻は未定のため、カレンダー上では開場時刻から3時間後に設定しています。"
			: "※開場・終了時刻は未定のため、カレンダー上では開演時刻から3時間後に設定しています。";

	const description = [
		timeInfo,
		"",
		endTimeNote,

		item.url &&
		item.url !== "#"
			? `\n詳細：\n${item.url}`
			: null,
	]
		.filter(Boolean)
		.join("\n");

	const params =
		new URLSearchParams({
			action:
				"TEMPLATE",

			text:
				item.title,

			dates:
				`${formatGoogleDate(startDate)}` +
				`/${formatGoogleDate(endDate)}`,

			location:
				item.venue || "",

			details:
				description,
		});

	return (
		"https://calendar.google.com/calendar/render?" +
		params.toString()
	);
};

/* =========================
   CALENDAR DATA
========================= */

const calendarItems =
	scheduleItems.map(
		(item) => ({
			date:
				item.date,

			type:
				item.type,
		})
	);

const firstCalendarDate =
	upcomingItems[0]?.date ||
	today;

const [
	initialYear,
	initialMonth,
] = firstCalendarDate
	.split("-")
	.map(Number);
---

<BaseLayout title="SCHEDULE">

	<main class="schedule-page">

		<h1>SCHEDULE</h1>

		<!-- =========================
		     FILTER
		========================== -->

		<div class="schedule-filter">

			<button
				class="filter-button active"
				type="button"
				data-filter="ALL"
			>
				ALL
			</button>

			<button
				class="filter-button"
				type="button"
				data-filter="EVENT"
			>
				イベント
			</button>

			<button
				class="filter-button"
				type="button"
				data-filter="LIVE"
			>
				ライブ
			</button>

			<button
				class="filter-button"
				type="button"
				data-filter="TICKET"
			>
				チケ発
			</button>

		</div>

		<!-- =========================
		     CALENDAR + LIST
		========================== -->

		<div class="schedule-layout">

			<!-- =====================
			     CALENDAR
			====================== -->

			<aside class="calendar-area">

				<div class="calendar">

					<div class="calendar-header">

						<button
							class="month-button"
							type="button"
							id="prev-month"
							aria-label="前の月"
						>
							‹
						</button>

						<div class="calendar-month">

							<strong id="calendar-month-number">
								{initialMonth}
							</strong>

							<div>
								<span id="calendar-month-name"></span>

								<small id="calendar-year">
									{initialYear}
								</small>
							</div>

						</div>

						<button
							class="month-button"
							type="button"
							id="next-month"
							aria-label="次の月"
						>
							›
						</button>

					</div>

					<div class="calendar-weekdays">
						<span>SUN</span>
						<span>MON</span>
						<span>TUE</span>
						<span>WED</span>
						<span>THU</span>
						<span>FRI</span>
						<span>SAT</span>
					</div>

					<div
						class="calendar-days"
						id="calendar-days"
					></div>

					<p class="calendar-note">
						水色の日付は予定あり。
						<br />
						クリックすると該当項目へ移動します。
					</p>

				</div>

			</aside>

			<!-- =====================
			     EVENT LIST
			====================== -->

			<div class="schedule-content">

				<!-- UPCOMING -->

				<section
					class="schedule-section"
					id="upcoming-section"
				>

					<div class="section-heading">

						<p>UPCOMING</p>

						<span id="upcoming-count">
							{upcomingItems.length} EVENTS
						</span>

					</div>

					<div class="schedule-list">

						{
							upcomingItems.map(
								(item) => {

									const formatted =
										formatDate(
											item.date
										);

									const calendarUrl =
										createGoogleCalendarUrl(
											item
										);

									const mapUrl =
										item.venue
											? createGoogleMapsUrl(
													item.venue
												)
											: null;

									return (
										<article
											id={item.id}
											class="schedule-item"
											data-type={item.type}
											data-date={item.date}
										>

											<div class="date">

												<span class="date-main">
													{formatted.date}
												</span>

												<span class="date-weekday">
													{formatted.weekday}
												</span>

											</div>

											<div class="event-info">

												<span
													class={`event-tag tag-${item.type.toLowerCase()}`}
												>
													{getTypeLabel(item.type)}
												</span>

												<h2>
													{item.title}
												</h2>

												<div class="event-meta">

													{
														item.isTicket ? (

															item.ticketTime && (
																<p>
																	<span>
																		TIME
																	</span>

																	発売 {item.ticketTime}
																</p>
															)

														) : (

															<>

																{
																	item.venue && (
																		<div class="venue-row">

																			<p>
																				<span>
																					VENUE
																				</span>

																				{item.venue}
																			</p>

																			{
																				mapUrl && (
																					<a
																						class="map-link"
																						href={mapUrl}
																						target="_blank"
																						rel="noopener noreferrer"
																						title="Google Mapsで開く"
																					>
																						<img
																							src="/images/icons/googlemaps.svg"
																							alt=""
																						/>

																						<span>
																							MAP
																						</span>
																					</a>
																				)
																			}

																		</div>
																	)
																}

																{
																	(item.open ||
																		item.start) && (
																		<p>
																			<span>
																				TIME
																			</span>

																			{
																				item.open &&
																				`OPEN ${item.open}`
																			}

																			{
																				item.open &&
																				item.start &&
																				" / "
																			}

																			{
																				item.start &&
																				`START ${item.start}`
																			}
																		</p>
																	)
																}

															</>

														)
													}

												</div>

												{
													item.url &&
													item.url !== "#" && (
														<a
															class="official-link"
															href={item.url}
															target="_blank"
															rel="noopener noreferrer"
														>
															{
																item.isTicket
																	? "チケット情報 →"
																	: "公式情報 →"
															}
														</a>
													)
												}

											</div>

											{
												calendarUrl && (
													<div class="calendar-action">

														<a
															class="calendar-link"
															href={calendarUrl}
															target="_blank"
															rel="noopener noreferrer"
															title="Google Calendarに追加"
														>
															<img
																src="/images/icons/googlecalendar.svg"
																alt=""
															/>

															<span>
																追加
															</span>
														</a>

													</div>
												)
											}

										</article>
									);
								}
							)
						}

					</div>

				</section>

				<!-- =====================
				     PAST
				====================== -->

				<section
					class="schedule-section past"
					id="past-section"
				>

					<div class="section-heading">

						<p>PAST</p>

						<span id="past-count">
							{pastItems.length} EVENTS
						</span>

					</div>

					<div class="schedule-list">

						{
							pastItems.map(
								(item) => {

									const formatted =
										formatDate(
											item.date
										);

									return (
										<article
											id={item.id}
											class="schedule-item past-item"
											data-type={item.type}
											data-date={item.date}
										>

											<div class="date">

												<span class="date-main">
													{formatted.date}
												</span>

												<span class="date-weekday">
													{formatted.weekday}
												</span>

											</div>

											<div class="event-info">

												<span
													class={`event-tag tag-${item.type.toLowerCase()}`}
												>
													{getTypeLabel(item.type)}
												</span>

												<h2>
													{item.title}
												</h2>

												<div class="event-meta">

													{
														item.isTicket ? (

															item.ticketTime && (
																<p>
																	<span>
																		TIME
																	</span>

																	発売 {item.ticketTime}
																</p>
															)

														) : (

															<>

																{
																	item.venue && (
																		<p>
																			<span>
																				VENUE
																			</span>

																			{item.venue}
																		</p>
																	)
																}

																{
																	(item.open ||
																		item.start) && (
																		<p>
																			<span>
																				TIME
																			</span>

																			{
																				item.open &&
																				`OPEN ${item.open}`
																			}

																			{
																				item.open &&
																				item.start &&
																				" / "
																			}

																			{
																				item.start &&
																				`START ${item.start}`
																			}
																		</p>
																	)
																}

															</>

														)
													}

												</div>

												{
													item.url &&
													item.url !== "#" && (
														<a
															class="official-link"
															href={item.url}
															target="_blank"
															rel="noopener noreferrer"
														>
															{
																item.isTicket
																	? "チケット情報 →"
																	: "公式情報 →"
															}
														</a>
													)
												}

											</div>

										</article>
									);
								}
							)
						}

					</div>

				</section>

			</div>

		</div>

	</main>

</BaseLayout>

<script
	define:vars={{
		calendarItems,
		initialYear,
		initialMonth
	}}
>
	const monthNames = [
		"JANUARY",
		"FEBRUARY",
		"MARCH",
		"APRIL",
		"MAY",
		"JUNE",
		"JULY",
		"AUGUST",
		"SEPTEMBER",
		"OCTOBER",
		"NOVEMBER",
		"DECEMBER",
	];

	let displayYear =
		initialYear;

	let displayMonth =
		initialMonth;

	let currentFilter =
		"ALL";

	const daysContainer =
		document.getElementById(
			"calendar-days"
		);

	const monthNumber =
		document.getElementById(
			"calendar-month-number"
		);

	const monthName =
		document.getElementById(
			"calendar-month-name"
		);

	const yearLabel =
		document.getElementById(
			"calendar-year"
		);

	const filterButtons =
		document.querySelectorAll(
			".filter-button"
		);

	const scheduleElements =
		document.querySelectorAll(
			".schedule-item"
		);

	const upcomingSection =
		document.getElementById(
			"upcoming-section"
		);

	const pastSection =
		document.getElementById(
			"past-section"
		);

	const upcomingCount =
		document.getElementById(
			"upcoming-count"
		);

	const pastCount =
		document.getElementById(
			"past-count"
		);

	const pad = (number) =>
		String(number).padStart(
			2,
			"0"
		);

	const getFilteredCalendarItems =
		() => {
			return calendarItems.filter(
				(item) =>
					currentFilter ===
						"ALL" ||
					item.type ===
						currentFilter
			);
		};

	const renderCalendar =
		() => {

			if (!daysContainer) {
				return;
			}

			daysContainer.innerHTML =
				"";

			if (monthNumber) {
				monthNumber.textContent =
					displayMonth;
			}

			if (monthName) {
				monthName.textContent =
					monthNames[
						displayMonth - 1
					];
			}

			if (yearLabel) {
				yearLabel.textContent =
					displayYear;
			}

			const firstDay =
				new Date(
					Date.UTC(
						displayYear,
						displayMonth - 1,
						1
					)
				).getUTCDay();

			const daysInMonth =
				new Date(
					Date.UTC(
						displayYear,
						displayMonth,
						0
					)
				).getUTCDate();

			const filteredItems =
				getFilteredCalendarItems();

			const activeDates =
				new Set(
					filteredItems.map(
						(item) =>
							item.date
					)
				);

			for (
				let i = 0;
				i < firstDay;
				i++
			) {
				const blank =
					document.createElement(
						"span"
					);

				blank.className =
					"calendar-day blank";

				daysContainer.appendChild(
					blank
				);
			}

			for (
				let day = 1;
				day <= daysInMonth;
				day++
			) {

				const date =
					`${displayYear}-` +
					`${pad(displayMonth)}-` +
					`${pad(day)}`;

				const hasSchedule =
					activeDates.has(
						date
					);

				const element =
					document.createElement(
						hasSchedule
							? "button"
							: "span"
					);

				element.className =
					"calendar-day";

				element.textContent =
					day;

				if (hasSchedule) {

					element.classList.add(
						"has-schedule"
					);

					element.type =
						"button";

					element.setAttribute(
						"aria-label",
						`${date}の予定を見る`
					);

					element.addEventListener(
						"click",
						() => {

							const targets =
								[
									...scheduleElements,
								].filter(
									(item) =>
										!item.hidden &&
										item.dataset.date ===
											date
								);

							const target =
								targets[0];

							if (!target) {
								return;
							}

							target.scrollIntoView({
								behavior:
									"smooth",

								block:
									"center",
							});

							target.classList.remove(
								"schedule-highlight"
							);

							void target.offsetWidth;

							target.classList.add(
								"schedule-highlight"
							);
						}
					);
				}

				daysContainer.appendChild(
					element
				);
			}
		};

	const updateSections =
		() => {

			let upcomingVisible =
				0;

			let pastVisible =
				0;

			scheduleElements.forEach(
				(item) => {

					const matches =
						currentFilter ===
							"ALL" ||
						item.dataset.type ===
							currentFilter;

					item.hidden =
						!matches;

					if (!matches) {
						return;
					}

					if (
						item.closest(
							"#upcoming-section"
						)
					) {
						upcomingVisible++;
					}

					if (
						item.closest(
							"#past-section"
						)
					) {
						pastVisible++;
					}
				}
			);

			if (upcomingCount) {
				upcomingCount.textContent =
					`${upcomingVisible} EVENTS`;
			}

			if (pastCount) {
				pastCount.textContent =
					`${pastVisible} EVENTS`;
			}

			if (upcomingSection) {
				upcomingSection.hidden =
					upcomingVisible ===
					0;
			}

			if (pastSection) {
				pastSection.hidden =
					pastVisible ===
					0;
			}
		};

	filterButtons.forEach(
		(button) => {

			button.addEventListener(
				"click",
				() => {

					currentFilter =
						button.dataset
							.filter ||
						"ALL";

					filterButtons.forEach(
						(item) =>
							item.classList.remove(
								"active"
							)
					);

					button.classList.add(
						"active"
					);

					updateSections();

					renderCalendar();
				}
			);
		}
	);

	document
		.getElementById(
			"prev-month"
		)
		?.addEventListener(
			"click",
			() => {

				displayMonth--;

				if (
					displayMonth < 1
				) {
					displayMonth = 12;
					displayYear--;
				}

				renderCalendar();
			}
		);

	document
		.getElementById(
			"next-month"
		)
		?.addEventListener(
			"click",
			() => {

				displayMonth++;

				if (
					displayMonth > 12
				) {
					displayMonth = 1;
					displayYear++;
				}

				renderCalendar();
			}
		);

	updateSections();

	renderCalendar();
</script>

