---

<header class="site-header">
	<a class="site-logo" href="/">
		KANNAGIMARO
	</a>

	<nav class="site-nav">
		<a href="/">HOME</a>
		<a href="/profile">PROFILE</a>
		<a href="/schedule">SCHEDULE</a>
		<a href="/works">WORKS</a>
	</nav>
</header>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 1000;

		width: 100%;
		height: 76px;
		padding: 0 48px;

		display: flex;
		align-items: center;
		justify-content: space-between;

		background: rgba(255, 255, 255, 0.92);

		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
		
		border-bottom: 1px solid #dcecf7;

		box-sizing: border-box;
	}

	.site-logo {
		color: #79aeca;
		font-size: 18px;
		font-weight: 500;
		letter-spacing: 0.18em;
		text-decoration: none;
	}

	.site-nav {
		display: flex;
		gap: 36px;
	}

	.site-nav a {
		position: relative;

		color: #7696aa;
		font-size: 12px;
		letter-spacing: 0.12em;
		text-decoration: none;

		transition: color 0.3s ease;
	}

	.site-nav a::after {
		content: "";
		position: absolute;

		left: 0;
		bottom: -8px;

		width: 100%;
		height: 1px;

		background: #9ed8ee;

		transform: scaleX(0);
		transform-origin: right;
		transition: transform 0.3s ease;
	}

	.site-nav a:hover {
		color: #9a91cf;
	}

	.site-nav a:hover::after {
		transform: scaleX(1);
		transform-origin: left;
	}
	@media (max-width: 700px) {
	.site-header {
		height: auto;
		padding: 18px 22px;

		flex-direction: column;
		align-items: flex-start;
		gap: 16px;
	}

	.site-logo {
		font-size: 15px;
	}

	.site-nav {
		width: 100%;

		gap: 0;

		justify-content: space-between;
	}

	.site-nav a {
		font-size: 9px;
	}

	.site-nav a::after {
		bottom: -5px;
	}
}
</style>